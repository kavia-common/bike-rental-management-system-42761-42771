# Backend configuration (Mobike)
# Used for CORS
MOBIKE_FRONTEND_ORIGIN=http://localhost:3000

# Used for frontend integration display / meta endpoint (not required for core functionality)
MOBIKE_BASE_URL=http://localhost:3001

# JWT configuration (CHANGE THIS in production)
MOBIKE_JWT_SECRET=change-me

# Token TTL (seconds)
MOBIKE_JWT_TTL_SECONDS=86400

# Demo seed passwords
MOBIKE_ADMIN_PASSWORD=admin123
MOBIKE_DEMO_USER_PASSWORD=user123
